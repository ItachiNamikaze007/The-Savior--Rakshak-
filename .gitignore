# ==============================================================================
# SoSquad RAKSHAK-NET - .gitignore
# Hardened against accidental secrets, build artifacts, and local configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials & Environment Configurations (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.p12
*.crt
*.cer
*credentials*.json
*serviceAccount*.json
*service_account*.json
new_api_key.txt
*api_key*.txt

# Android Keystore & Signing Configs
*.jks
*.keystore
android/key.properties
key.properties

# Firebase & Cloud Debug Logs
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ------------------------------------------------------------------------------
# Flutter & Dart
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Flutter / Dart symbol maps & coverage
app.*.symbols
app.*.map.json
coverage/

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
.gradle/
android/.gradle/
android/local.properties
android/captures/
android/app/src/main/assets/
android/app/build/

# ------------------------------------------------------------------------------
# iOS & macOS
# ------------------------------------------------------------------------------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/flutter_assets
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# ------------------------------------------------------------------------------
# IDE & System Files
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Project Specific & Nested Modules
# ------------------------------------------------------------------------------
Local-Mesh-Communication-Node/
Local-Mesh-Communication-Nodes/